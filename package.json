{
  "name": "github-agent",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:lambda && npm run build:agent && npm run build:site",
    "build:lambda": "cd infra && npm run build",
    "build:agent": "cd agent && npm run build",
    "build:site": "cd site && npm run build",
    "dev:site": "cd site && npm run dev",
    "deploy": "cd infra && npx cdk deploy --all",
    "synth": "cd infra && npx cdk synth",
    "test": "cd infra && npm run test",
    "test:watch": "cd infra && npm run test:watch",
    "prepare": "husky install"
  },
  "devDependencies": {
    "husky": "^9.0.0"
  }
}
