# GitHub OAuth App (from GitHub Developer Settings)
GITHUB_ID=your_github_oauth_app_id
GITHUB_SECRET=your_github_oauth_app_secret

# NextAuth.js session encryption
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_generated_secret_here

# Full URL of your deployment
NEXTAUTH_URL=http://localhost:3000
# For production:
# NEXTAUTH_URL=https://agent.cenetex.com

# AWS Configuration for S3 credit and artifact data
AWS_REGION=us-east-1
ARTIFACTS_BUCKET=github-agent-artifacts-account-us-east-1
CREDITS_BUCKET=github-agent-credits-account-us-east-1

# GitHub App configuration
GITHUB_APP_SLUG=cenetex-coding-agent

# Optional: AWS credentials (if not using IAM role)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
